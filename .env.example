# ──────────────────────────────────────────────────────────────────
# Site
# ──────────────────────────────────────────────────────────────────
SITE_URL=https://affiliate-hub.vn

# ──────────────────────────────────────────────────────────────────
# Analytics & Newsletter (optional, public PREFIX → exposed to client)
# ──────────────────────────────────────────────────────────────────
PUBLIC_PLAUSIBLE_DOMAIN=affiliate-hub.vn
PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# ──────────────────────────────────────────────────────────────────
# Accesstrade Publisher API
# Dashboard → Publisher API → Generate Token
# ──────────────────────────────────────────────────────────────────
ACCESSTRADE_API_TOKEN=
ACCESSTRADE_PUBLISHER_ID=
ACCESSTRADE_API_BASE=https://api.accesstrade.vn/v1

# ──────────────────────────────────────────────────────────────────
# Claude / Anthropic API (for content automation)
# https://console.anthropic.com → API Keys
# ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=8000

# ──────────────────────────────────────────────────────────────────
# Telegram Bot (for automation notifications)
# 1. Chat @BotFather → /newbot → note token
# 2. /start your bot → visit api.telegram.org/bot<TOKEN>/getUpdates → note chat_id
# ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ──────────────────────────────────────────────────────────────────
# Automation safety controls
# ──────────────────────────────────────────────────────────────────
AUTO_DRAFT_ENABLED=true
AUTO_DRAFT_MAX_PER_RUN=3
AUTO_DRAFT_MIN_PAYOUT_VND=100000

# ──────────────────────────────────────────────────────────────────
# Cloudflare (D1, Pages deploy via GitHub Actions)
# ──────────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
