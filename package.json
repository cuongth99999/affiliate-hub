{
  "name": "affiliate-hub",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Vietnamese personal finance affiliate hub — built with Astro + Tailwind + Cloudflare Pages",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "tsx scripts/build-affiliate-links.ts && astro check && astro build",
    "build:links": "tsx scripts/build-affiliate-links.ts",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts,.tsx,.astro",
    "type-check": "astro check && tsc --noEmit",
    "at:sync": "tsx scripts/accesstrade/sync-campaigns.ts",
    "at:hot": "tsx scripts/accesstrade/find-hot.ts",
    "at:conversions": "tsx scripts/accesstrade/sync-conversions.ts",
    "draft:one": "tsx scripts/content/draft-post.ts",
    "draft:weekly": "tsx scripts/pipeline/weekly-draft.ts",
    "stats:weekly": "tsx scripts/pipeline/weekly-stats.ts",
    "notify:test": "tsx scripts/notify/telegram.ts test",
    "d1:create": "wrangler d1 create affiliate-hub-clicks",
    "d1:migrate:local": "wrangler d1 execute affiliate-hub-clicks --local --file=migrations/0001_init_click_events.sql",
    "d1:migrate:prod": "wrangler d1 execute affiliate-hub-clicks --remote --file=migrations/0001_init_click_events.sql"
  },
  "dependencies": {
    "astro": "^5.1.0",
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/react": "^4.1.0",
    "@astrojs/sitemap": "^3.2.0",
    "@astrojs/tailwind": "^5.1.0",
    "@astrojs/check": "^0.9.0",
    "@astrojs/rss": "^4.0.0",
    "tailwindcss": "^3.4.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/forms": "^0.5.9",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "lucide-react": "^0.460.0",
    "zod": "^3.23.0",
    "date-fns": "^4.1.0",
    "reading-time": "^1.5.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.0",
    "rehype-slug": "^6.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "remark-toc": "^9.0.0",
    "@anthropic-ai/sdk": "^0.32.0",
    "dotenv": "^16.4.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "eslint": "^9.16.0",
    "eslint-plugin-astro": "^1.3.1",
    "wrangler": "^3.95.0"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.2.2"
}
