---
import AffiliateButton from './AffiliateButton.astro';
import RatingStars from '@components/content/RatingStars.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  product: CollectionEntry<'products'>;
  rating?: number;
  cta?: string;
  highlight?: boolean;
}

const { product, rating, cta = 'Mở thẻ ngay', highlight = false } = Astro.props;
const { name, brand, short_description, affiliate_slug } = product.data;
---

<div
  class:list={[
    'rounded-xl border bg-white p-5 transition-shadow hover:shadow-md',
    highlight ? 'border-brand-500 ring-1 ring-brand-200' : 'border-gray-200',
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <div>
      <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">{brand}</div>
      <h3 class="mt-0.5 text-lg font-bold text-gray-900">{name}</h3>
    </div>
    {highlight && (
      <span class="rounded-full bg-brand-100 px-2.5 py-1 text-xs font-semibold text-brand-700">
        Đề xuất
      </span>
    )}
  </div>

  {rating !== undefined && (
    <div class="mt-2">
      <RatingStars rating={rating} />
    </div>
  )}

  {short_description && (
    <p class="mt-3 text-sm leading-relaxed text-gray-700">{short_description}</p>
  )}

  {affiliate_slug && (
    <div class="mt-4">
      <AffiliateButton slug={affiliate_slug} size="md">
        {cta}
      </AffiliateButton>
    </div>
  )}
</div>
