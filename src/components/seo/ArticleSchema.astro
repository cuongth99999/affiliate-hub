---
import JsonLd from './JsonLd.astro';
import { articleSchema } from '@lib/schema';

interface Props {
  headline: string;
  description: string;
  url: string;
  imageUrl: string;
  authorName: string;
  authorUrl: string;
  datePublished: string;
  dateModified: string;
}

const props = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
---

<JsonLd data={articleSchema({ ...props, siteUrl })} />
