---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { getEntry } from 'astro:content';
import PostLayout from './PostLayout.astro';
import ProsConsBox from '@components/content/ProsConsBox.astro';
import RatingStars from '@components/content/RatingStars.astro';
import ProductCard from '@components/affiliate/ProductCard.astro';
import ReviewSchema from '@components/seo/ReviewSchema.astro';
import FaqSchema from '@components/seo/FaqSchema.astro';
import { canonicalUrl, isoDate } from '@lib/utils';
import { postUrl } from '@lib/content';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { rating, pros, cons, product, faqs, date, author, title } = post.data;

const productEntry = product ? await getEntry(product) : null;
const authorEntry = await getEntry(author);
const authorName = authorEntry?.data.name ?? '';

const siteUrl = Astro.site?.toString() ?? 'https://affiliate-hub.vn/';
const url = canonicalUrl(postUrl(post), siteUrl);
---

<PostLayout post={post} headings={headings}>
  {productEntry && rating !== undefined && (
    <ReviewSchema
      slot="head"
      productName={productEntry.data.name}
      productBrand={productEntry.data.brand}
      productCategory={productEntry.data.category}
      rating={rating}
      reviewBody={post.data.description}
      authorName={authorName}
      datePublished={isoDate(date)}
      url={url}
    />
  )}

  {faqs && faqs.length > 0 && <FaqSchema slot="head" items={faqs} />}

  {productEntry && (
    <div class="not-prose mb-6 grid gap-6 md:grid-cols-3">
      <div class="md:col-span-1">
        <ProductCard product={productEntry} rating={rating} highlight />
      </div>
      <div class="md:col-span-2">
        {rating !== undefined && (
          <div class="mb-3">
            <div class="text-xs uppercase tracking-wide text-gray-500">Đánh giá tổng quan</div>
            <div class="mt-1">
              <RatingStars rating={rating} />
            </div>
          </div>
        )}
        {pros && cons && <ProsConsBox pros={pros} cons={cons} />}
      </div>
    </div>
  )}

  <slot />

  {faqs && faqs.length > 0 && (
    <section slot="after-body" class="mt-10">
      <h2 class="text-2xl font-bold text-gray-900">Câu hỏi thường gặp</h2>
      <div class="mt-4 space-y-4">
        {faqs.map((faq) => (
          <details class="group rounded-lg border border-gray-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-gray-900">{faq.q}</summary>
            <p class="mt-2 text-gray-700">{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}
</PostLayout>
