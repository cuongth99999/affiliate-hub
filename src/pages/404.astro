---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Không tìm thấy trang (404)" description="Trang bạn tìm không tồn tại." noindex>
  <div class="container-prose py-20 text-center">
    <p class="text-6xl font-bold text-brand-600">404</p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900">Không tìm thấy trang</h1>
    <p class="mt-3 text-gray-600">Trang bạn tìm có thể đã được di chuyển hoặc không còn tồn tại.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a
        href="/"
        class="rounded-md bg-brand-600 px-5 py-3 text-base font-semibold text-white hover:bg-brand-700"
      >
        Về trang chủ
      </a>
      <a
        href="/the-tin-dung/"
        class="rounded-md border border-gray-300 bg-white px-5 py-3 text-base font-semibold text-gray-700 hover:bg-gray-50"
      >
        Xem chuyên mục
      </a>
    </div>
  </div>
</BaseLayout>
