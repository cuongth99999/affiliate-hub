---
import { getCollection } from 'astro:content';
import PillarLayout from '@layouts/PillarLayout.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { CLUSTERS, type Cluster } from '@content/config';
import { CLUSTER_LABELS, CLUSTER_DESCRIPTIONS, getPostsByCluster, postUrl, TYPE_LABELS } from '@lib/content';

export async function getStaticPaths() {
  return CLUSTERS.map((cluster) => ({ params: { cluster } }));
}

const { cluster } = Astro.params as { cluster: Cluster };

const pillarPosts = await getCollection(
  'posts',
  ({ data }) => !data.draft && data.cluster === cluster && data.type === 'pillar',
);
const pillarPost = pillarPosts[0];

const rendered = pillarPost ? await pillarPost.render() : null;
const clusterPosts = await getPostsByCluster(cluster);
---

{
  pillarPost && rendered ? (
    <PillarLayout post={pillarPost} headings={rendered.headings}>
      <rendered.Content />
    </PillarLayout>
  ) : (
    <BaseLayout
      title={`${CLUSTER_LABELS[cluster]} — Affiliate Hub`}
      description={CLUSTER_DESCRIPTIONS[cluster]}
    >
      <div class="container-wide py-12">
        <h1 class="text-4xl font-bold tracking-tight text-gray-900">{CLUSTER_LABELS[cluster]}</h1>
        <p class="mt-3 text-lg text-gray-600">{CLUSTER_DESCRIPTIONS[cluster]}</p>

        {clusterPosts.length === 0 ? (
          <p class="mt-12 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-12 text-center text-gray-500">
            Chuyên mục này đang được xây dựng — quay lại sau nhé.
          </p>
        ) : (
          <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {clusterPosts.map((post) => (
              <a
                href={postUrl(post)}
                class="group rounded-lg border border-gray-200 bg-white p-5 transition-shadow hover:shadow-md"
              >
                <div class="text-xs font-semibold uppercase tracking-wide text-brand-600">
                  {TYPE_LABELS[post.data.type]}
                </div>
                <h3 class="mt-2 text-lg font-semibold text-gray-900 group-hover:text-brand-700">
                  {post.data.title}
                </h3>
                <p class="mt-2 line-clamp-2 text-sm text-gray-600">{post.data.description}</p>
              </a>
            ))}
          </div>
        )}
      </div>
    </BaseLayout>
  )
}
