---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/navigation/Breadcrumbs.astro';

const TOOLS = [
  {
    title: 'Quiz: Thẻ tín dụng nào phù hợp?',
    description: 'Trả lời 4 câu hỏi để tìm thẻ tín dụng phù hợp với thu nhập, độ tuổi và mục đích.',
    href: '/cong-cu/the-tin-dung-nao-phu-hop/',
    icon: '🎯',
  },
  {
    title: 'Tính lãi vay tiêu dùng',
    description: 'Tính tiền trả hàng tháng, tổng lãi phải trả khi vay tiêu dùng.',
    href: '/cong-cu/tinh-lai-vay/',
    icon: '🧮',
  },
  {
    title: 'Tính lãi tiết kiệm',
    description: 'Tính tiền lãi nhận được khi gửi tiết kiệm theo kỳ hạn.',
    href: '/cong-cu/tinh-lai-tiet-kiem/',
    icon: '💰',
  },
];
---

<BaseLayout
  title="Công cụ tài chính"
  description="Bộ công cụ miễn phí giúp bạn ra quyết định tài chính: quiz tìm thẻ, tính lãi vay, tính lãi tiết kiệm."
>
  <div class="container-wide py-12">
    <Breadcrumbs items={[{ name: 'Trang chủ', url: '/' }, { name: 'Công cụ', url: '/cong-cu/' }]} />

    <header class="mt-6 max-w-2xl">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900">Công cụ tài chính</h1>
      <p class="mt-3 text-lg text-gray-600">
        Bộ công cụ miễn phí, chạy ngay trên browser, không lưu dữ liệu cá nhân.
      </p>
    </header>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        TOOLS.map((tool) => (
          <a
            href={tool.href}
            class="group rounded-xl border border-gray-200 bg-white p-6 transition-shadow hover:shadow-md"
          >
            <div class="text-3xl">{tool.icon}</div>
            <h2 class="mt-3 text-xl font-bold text-gray-900 group-hover:text-brand-700">
              {tool.title}
            </h2>
            <p class="mt-2 text-sm text-gray-600">{tool.description}</p>
            <span class="mt-3 inline-block text-sm font-semibold text-brand-600 group-hover:underline">
              Mở công cụ →
            </span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
